# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO — SOLO REFERENCIA
# ============================================================
# Este archivo es una PLANTILLA documentada.
# NO contiene valores reales ni secretos.
#
# Las variables reales se configuran en:
#   Railway → Tu proyecto → Variables
#
# NUNCA hagas commit de un archivo con valores reales.
# ============================================================

# Entorno de despliegue (Railway inyecta RAILWAY_ENVIRONMENT
# automáticamente; estas variables son un respaldo adicional)
DEPLOYMENT_ENV=production
NODE_ENV=production

# Puerto que expone Streamlit (Railway lo asigna dinámicamente,
# pero 8501 es el valor por defecto en el Dockerfile)
STREAMLIT_SERVER_PORT=8501

# Cadena de conexión a SQLiteCloud
# Formato: sqlitecloud://<HOST>:<PORT>/<DB>?apikey=<API_KEY>
# Obtén estos valores desde el panel de SQLiteCloud:
#   https://dashboard.sqlitecloud.io
SQLITECLOUD_CONNECTION_STRING=sqlitecloud://<HOST>:<PORT>/<DB>?apikey=<API_KEY>
